{
  "name": "done-coding-github-io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r run build && node scripts/assemble.mjs",
    "check": "node scripts/check-site.mjs",
    "verify": "pnpm build && pnpm check && node scripts/test-site.mjs",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "postinstall": "prettier --write ./pnpm-lock.yaml",
    "lint:eslint": "eslint --no-error-on-unmatched-pattern apps scripts packages acceptance --ext .js,.mjs,.cjs,.ts,.tsx,.jsx,.vue",
    "lint:format": "prettier --check apps scripts packages acceptance",
    "lint:names": "ls-lint",
    "lint": "pnpm lint:eslint && pnpm lint:format && pnpm lint:names",
    "acceptance": "node acceptance/run.mjs",
    "acceptance:test": "node --test \"acceptance/test/*.test.mjs\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@ls-lint/ls-lint": "^2.2.3",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.49.0",
    "eslint-config-alloy": "^5.1.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-vue": "^9.25.0",
    "husky": "^8.0.3",
    "lint-staged": "^12.5.0",
    "prettier": "^3.0.3",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^9.4.2"
  },
  "lint-staged": {
    "{apps,scripts,packages,acceptance}/**/*": [
      "ls-lint"
    ],
    "{apps,scripts,packages,acceptance}/**/*.{ts,js,mjs,cjs,vue,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{apps,scripts,packages,acceptance}/**/*.{json,html,css,scss,less,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
